# =====================================================
# Ambativasi API - Environment Configuration
# Copy file ini menjadi ".env" lalu isi nilainya.
# JANGAN pernah commit ".env" ke repository!
# =====================================================

# --- Koneksi Database (XAMPP default: localhost/root kosong) ---
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=ambativasi

# --- Base URL API (ganti saat deploy ke hosting) ---
# Contoh XAMPP+ngrok: https://xxxx.ngrok-free.dev/ambativasi-api
# Contoh InfinityFree: https://app-id.infinityfreeapp.com/ambativasi-api
BASE_URL=https://banked-faculty-setup.ngrok-free.dev/ambativasi-api

# --- Gemini API Key (untuk chat-ai & generate-soal) ---
GEMINI_API_KEY=

# --- SMTP Gmail (untuk fitur lupa password) ---
# Gunakan "App Password" Gmail, bukan password akun biasa.
SMTP_EMAIL=
SMTP_PASSWORD=
